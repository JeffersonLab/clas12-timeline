#!/usr/bin/env bash

set -euo pipefail
source $(dirname $0)/../libexec/environ.sh

# constants ############################################################
# slurm settings
SLURM_MEMORY=2000 # must be more than max heap size `java` calls
SLURM_DISK=32M
SLURM_TIME=12:00:00
SLURM_LOG=/farm_out/%u/%x-%A_%a
# reheating methods: name -> description
declare -A REHEAT_METHODS=(
  [rollover]="fix the clock rollover and rebuild scalers"
)
########################################################################

# default options
dataset=train
coatjava_version=13.8.5 # 13.3.0: first version with rollover correction, used for RG-A Spring 2018 reheating
                        # 13.8.0: fix: avoid call to method that recalibrates already-calibrated dsc2
                        #         https://github.com/JeffersonLab/coatjava/pull/1153
declare -A modes
for key in submit series dstdir skimdir; do
  modes[$key]=false
done

# usage
sep="================================================================"
usage() {
  echo """
  Reproduce cooked data
  NOTE: chefs should not typically need to run this

  $sep
  USAGE: qtl reheat [OPTIONS] [INPUT_DIR]...
  $sep

  REQUIRED OPTIONS:
     -o [OUTPUT_DIR]   output directory
     -m [METHOD]       which reheating method to use, one of:

     [INPUT_DIR]...    input data directory; you may specify more than one
                         - use with \`--dstdir\` if specifying DST files
                         - use with \`--skimdir\` if specifying skim files (trains)
                         - use \`--help\` for more details
                         **must be specified last**
$(for key in "${!REHEAT_METHODS[@]}"; do printf "%24s %-11s %-s\n" "" "$key" "${REHEAT_METHODS[$key]}"; done)

  OPTIONAL OPTIONS:
     -d [DATASET]      unique name for this dataset
                       default: $dataset
     -c [COATJAVA_VER] coatjava version number, either
                       - version from coatjava env module
                       - absolute path to coatjava
                       default: $coatjava_version

     *** EXECUTION CONTROL OPTIONS:

     --submit          submit the slurm jobs now
                       default: print the SLURM \`sbatch\` command

     --series          run all jobs locally, one at a time; rather
                       than running with slurm

     *** INPUT FINDING OPTIONS:

     --dstdir          assume each specified [INPUT_DIR] contains
                       subdirectories named as just run numbers, e.g., like the DSTs
                       - it is not recommended to use wildcards for this option
                       - see also the \`--fast-ls\` option
                       - legacy option name \`--rundir\` is equivalent

     --skimdir         assume each specified [INPUT_DIR] contains HIPO
                       files, with one run per file; e.g., a directory of SKIM files
                       - legacy option name \`--flatdir\` is equivalent
                       **this is the DEFAULT option**
  """ >&2
}
if [ $# -lt 1 ]; then
  usage
  exit 101
fi

# parse options
outputDir=""
mtd=""
while getopts "o:m:d:c:h-:" opt; do
  case $opt in
    o) outputDir=$OPTARG ;;
    m)
      [ -z "${REHEAT_METHODS[$OPTARG]-}" ] && printError "unknown command '$OPTARG'" && exit 100
      mtd=$OPTARG
      ;;
    d) dataset=$OPTARG ;;
    c) coatjava_version=$OPTARG ;;
    h)
      usage
      exit 101
      ;;
    -)
      for key in "${!modes[@]}"; do
        [ "$key" == "$OPTARG" ] && modes[$OPTARG]=true && break
      done
      [ -z "${modes[$OPTARG]-}" ] && printError "unknown option --$OPTARG" && exit 100
      ;;
    *) exit 100 ;;
  esac
done
shift $((OPTIND - 1))

# check required arguments
[ -z "$outputDir" ] && printError "missing output directory argument" && exit 100
[ -z "$mtd" ] && printError "missing method argument" && exit 100

# set the input-finding method; use the DEFAULT one, if not set by user
## count how many were set
numTrueInputOpts=0
for key in dstdir skimdir; do
  if ${modes[$key]}; then
    numTrueInputOpts=$((numTrueInputOpts+1))
  fi
done
## set a DEFAULT one, if none are set, or complain if more than one
if [ $numTrueInputOpts -eq 0 ]; then
  modes['skimdir']=true
elif [ $numTrueInputOpts -gt 1 ]; then
  printError "more than one input-finding option set"
  exit 100
fi

# parse input directories
rdirs=()
[ $# == 0 ] && printError "no input directories specified" && exit 100
rdirsArgs="$@"
for topdir in ${rdirsArgs[@]}; do
  [[ "$topdir" =~ ^- ]] && printError "option '$topdir' must be specified before input directories" && exit 100
done
if ${modes['dstdir']}; then
  for topdir in ${rdirsArgs[@]}; do
    if [ -d $topdir ]; then
      for subdir in $(ls $topdir | grep -E "[0-9]+"); do
        rdirs+=($(echo "$topdir/$subdir " | sed 's;//;/;g'))
      done
    else
      printError "input directory '$topdir' does not exist"
      exit 100
    fi
  done
elif ${modes['skimdir']}; then
  for rdir in ${rdirsArgs[@]}; do
    for hipofile in $(ls $(realpath $rdir)/*.hipo); do
      rdirs+=($hipofile)
    done
  done
else
  printError "unknown input option"
  exit 100
fi
[ ${#rdirs[@]} -eq 0 ] && printError "no input directories found" && exit 100
echo "done finding input input directories:"
echo "INPUTS = ["
for rdir in ${rdirs[@]}; do echo "  $rdir,"; done
echo "]"

# make output directory
mkdir -p $outputDir
outputDir=$(realpath $outputDir)

# start job lists
jobName=reheat.$mtd.$dataset
slurmDir=./slurm
mkdir -p $slurmDir/scripts
jobList=$slurmDir/job.$jobName.list
> $jobList

# loop over rdirs
echo """
Generating job scripts..."""
for rdir in ${rdirs[@]}; do

  echo "processing '$rdir'..."

  # get list of input files for this rdir
  inputListFile=$slurmDir/files.reheat.$dataset.$(basename $rdir .hipo).inputs.list
  if ${modes['skimdir']}; then
    realpath $rdir > $inputListFile
  else
    rdir_mss=$(realpath $rdir | sed 's;^.*/cache/;/mss/;')
    rdir_cache=$(realpath $rdir)
    # `jasmine list-files` requires the stub files on `mss` to exist; if a cook is ongoing,
    # it's possible the `/mss` directory won't be populated yet, although files are already on `/cache`; for that case,
    # fall back to "slow" ls
    jasmine list-files -display json -under $rdir_mss | jq -r '.[].mss' | xargs -n1 basename | sed "s;^;${rdir_cache}/;" > $inputListFile \
      || { printWarning "falling back to slow ls..."; realpath $rdir/*.hipo > $inputListFile; }
  fi

  # loop over input files, building the job list
  while read inputFile; do
    # set output name
    inputBase=$(basename $inputFile .hipo)
    if ${modes['skimdir']}; then
      outputSubdir=$outputDir
    elif ${modes['dstdir']}; then
      outputSubdir=$outputDir/$(basename $(dirname $inputFile))
    fi
    outputFile=$outputSubdir/$inputBase.hipo

    # start job script
    jobScript=$slurmDir/scripts/$jobName.$inputBase.sh
    cat > $jobScript << EOF
#!/usr/bin/env bash
set -eou pipefail
# set env vars
source $TIMELINESRC/libexec/environ.sh
# logger info
echo "INPUT FILE:  $inputFile"
echo "OUTPUT FILE: $outputFile"
EOF

    # handle coatjava
    if [[ "$coatjava_version" == /* ]]; then
      cat >> $jobScript << EOF
# set coatjava environment
export COATJAVA=$coatjava_version
export CLAS12DIR=\$COATJAVA
echo "COATJAVA:    \$COATJAVA"
EOF
    else
      cat >> $jobScript << EOF
# load coatjava module
source /usr/share/Modules/init/bash
module purge
module use /scigroup/cvmfs/hallb/clas12/sw/modulefiles
module load clas12
module switch coatjava/$coatjava_version
echo "COATJAVA:    \$COATJAVA"
EOF
    fi

    # add main command to the job script
    case $mtd in

      rollover)
        mkdir -p $outputSubdir/tmp
        tmpFile=$outputSubdir/tmp/$inputBase.hipo
        cat >> $jobScript << EOF
# remove output files, if they exist
[ -f "$tmpFile" ] && echo "WARNING: clobbering $tmpFile" >&2 && rm -v $tmpFile
[ -f "$outputFile" ] && echo "WARNING: clobbering $outputFile" >&2 && rm -v $outputFile
# fix the clock rollover
echo "TMP FILE:    $tmpFile"
\$COATJAVA/bin/rebuild-scalers -l INFO -c X -o $tmpFile $inputFile -- -Xmx1536m
\$COATJAVA/bin/postprocess -l INFO -q 1 -o $outputFile $tmpFile
rm -v $tmpFile
EOF

    esac

    # finish the job script
    cat >> $jobScript << EOF
# check output file
$TIMELINESRC/libexec/hipo-check.sh $outputFile
EOF

    # grant permission and add it to the job list
    chmod u+x $jobScript
    echo $jobScript >> $jobList
  done < <(cat $inputListFile)

done

# run the job(s)
if ! ${modes['series']}; then
  # generate slurm descriptions and/or local scripts
  slurmScript=$(echo $jobList | sed 's;.list$;.slurm;')
  cat > $slurmScript << EOF
#!/bin/sh
#SBATCH --ntasks=1
#SBATCH --job-name=$jobName
#SBATCH --output=$SLURM_LOG.out
#SBATCH --error=$SLURM_LOG.err
#SBATCH --partition=production
#SBATCH --account=clas12
#SBATCH --mem-per-cpu=$SLURM_MEMORY
#SBATCH --gres=disk:$SLURM_DISK
#SBATCH --time=$SLURM_TIME
#SBATCH --array=1-$(cat $jobList | wc -l)
#SBATCH --ntasks=1
srun \$(head -n\$SLURM_ARRAY_TASK_ID $jobList | tail -n1)
EOF
  # submit slurm jobs
  echo """
  SLURM SCRIPT: $slurmScript
  JOB LIST:     $jobList
  """
  if ${modes['submit']}; then
    echo "Now submitting!"
    sbatch $slurmScript
  else
    echo """Run this SLURM command to submit:
    sbatch $slurmScript

    Alternatively, run with \'--series\' to run sequentially
    """
  fi
else
  # if not using slurm, run now
  chmod u+x $jobList
  exec $jobList
fi
